# Ambiente de execução (dev / staging / prod)
APP_ENV=dev

# Porta exposta pela aplicação
PORT=8000

# Nível de log (debug / info / warning / error)
LOG_LEVEL=info

# A variável DATABASE_URL será adicionada quando a integração
# com o PostgreSQL for implementada (Fase 1). Não incluir credenciais.
# DATABASE_URL=
